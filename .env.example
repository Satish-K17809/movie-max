# Copy this file to ".env" (same folder as app.py) for running on your own computer.
# On Render you do NOT upload .env - you type these same names/values into Render's
# "Environment" tab instead (see DEPLOY.md).

MONGO_URI=mongodb://localhost:27017
SECRET_KEY=change-this-to-a-long-random-text
EMAIL_ADDRESS=yourgmail@gmail.com
EMAIL_PASSWORD=your16letterapppassword

# Optional: admin login (if you leave these out, the defaults Satish / 123456 are used)
# ADMIN_ID=Satish
# ADMIN_PASSWORD=123456
